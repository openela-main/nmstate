 }
 
+fn mac_match_rules(
+    permanent_mac: Option<&String>,
+    mac: Option<&String>,
+    driver: Option<&String>,
+) -> Option<String> {
+    let mut rules = if let Some(mac) = permanent_mac {
+        format!("PermanentMACAddress={mac}")
+    } else {
+        let mac = mac?;
+        format!("MACAddress={mac}")
+    };
+    if let Some(driver) = driver {
+        write!(rules, "\nDriver={driver}").ok();
+    }
+    Some(rules)
+}
